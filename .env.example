# Copy to .env. Docker Compose reads this file automatically.
# The API reads the connection strings below.

# Postgres
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise
POSTGRES_DB=mise
POSTGRES_PORT=5432
DATABASE_URL=postgres://mise:mise@localhost:5432/mise

# Neo4j (password must be at least 8 characters)
NEO4J_PASSWORD=mise-dev-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# LLM provider: ollama locally, bedrock in the AWS phase
LLM_PROVIDER=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

# API
API_PORT=3000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4200
AUTH_PROVIDER=local
DEV_USER_EMAIL=dev@mise.local
LOG_LEVEL=info

# Tests: leave unset to use Testcontainers (needs Docker).
# Set it to reuse a running Postgres. That database gets WIPED.
# TEST_DATABASE_URL=postgres://mise:mise@localhost:5432/mise_test
