# Copy to .env. Docker Compose reads this file automatically.
# The API reads the connection strings below.

# Postgres
POSTGRES_USER=stockpot
POSTGRES_PASSWORD=stockpot
POSTGRES_DB=stockpot
POSTGRES_PORT=5432
DATABASE_URL=postgres://stockpot:stockpot@localhost:5432/stockpot

# Neo4j (password must be at least 8 characters)
NEO4J_PASSWORD=stockpot-dev-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# LLM provider: ollama locally, bedrock in the AWS phase
LLM_PROVIDER=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=30m

# API
API_PORT=3000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4200
AUTH_PROVIDER=local
DEV_USER_EMAIL=dev@stockpot.local
LOG_LEVEL=info

# Tests: leave unset to use Testcontainers (needs Docker).
# Set it to reuse a running Postgres. That database gets WIPED.
# TEST_DATABASE_URL=postgres://stockpot:stockpot@localhost:5432/stockpot_test
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:3b
LLM_TIMEOUT_MS=600000


STORAGE_DRIVER=local
STORAGE_DIR=data/uploads

### 
# How the decline distance threshold was set: 
#   questions the recipes answer had a closest chunk at 0.11 to 0.25, 
#    and questions they don't were at 0.40 and above. 
# Max Source token depends on MODEL + Device used.
ASK_MAX_DISTANCE=0.35
ASK_MAX_SOURCE_TOKENS=2000